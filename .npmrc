# Turn the `engines` field into a hard error instead of a warning.
#
# Without this, npm only prints EBADENGINE and installs anyway — which is
# exactly what happened on Node 20.11.1: the warning scrolled past, the install
# "succeeded", and the failure surfaced much later as an unrelated-looking
# `SyntaxError: 'node:util' does not provide an export named 'styleText'` from
# inside rolldown (util.styleText landed in Node 20.12.0). Failing at install
# time points straight at the cause.
#
# Note this applies to dependencies' engines too, not just ours. If a transitive
# package ever ships a bogus range and blocks a legitimate install, delete this
# line rather than downgrading Node.
engine-strict=true
